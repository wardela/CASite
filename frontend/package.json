{
  "name": "fawtartak-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Fawtartak sales and e-invoicing platform",
  "author": "Fawtartak",
  "scripts": {
    "start": "electron-forge start",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "package": "electron-forge package",
    "electron": "cross-env NODE_ENV=development electron ./electron/main.cjs",
    "electron:build": "npm run build && cross-env NODE_ENV=production electron-builder",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "daisyui": "^4.12.22",
    "dayjs": "^1.11.13",
    "dgram": "^1.0.1",
    "dotenv": "^16.4.7",
    "electron-is-dev": "^3.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "i18next": "^24.2.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "quill-delta-to-html": "^0.12.1",
    "react": "^18.3.1",
    "react-datepicker": "^7.6.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-quill": "^2.0.0",
    "react-to-print": "^2.14.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-deb": "^7.6.1",
    "@electron-forge/maker-rpm": "^7.6.1",
    "@electron-forge/maker-squirrel": "^7.6.1",
    "@electron-forge/maker-zip": "^7.6.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.1",
    "@electron-forge/plugin-fuses": "^7.6.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^7.6.0",
    "electron": "^33.2.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.fawtartak.app",
    "productName": "Fawtartak",
    "extraFiles": [
      {
        "from": "clinic-app-backend",
        "to": "backend"
      }
    ],
    "directories": {
      "output": "dist_electron"
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "assets/logo"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "fawtartak_app",
            "setupIcon": "assets/logo.ico",
            "shortcutName": "Fawtartak",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
